#!/usr/bin/env bash
# .githooks/pre-commit — fast local checks (no network, no servers).
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
# Prefer the project venv when present, else $VIRTUAL_ENV, else system python.
if [[ -n "${FASTERAPI_PY:-}" ]]; then
  PY="$FASTERAPI_PY"
elif [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
elif [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python" ]]; then
  PY="$VIRTUAL_ENV/bin/python"
else
  PY="python3"
fi

echo "=== fasterapi pre-commit ($PY) ==="
# Rust formatting (advisory — never blocks).
if command -v cargo >/dev/null 2>&1; then
  cargo fmt --check 2>/dev/null || echo "  (cargo fmt: differences found — run 'cargo fmt')"
fi
# Python lint: ruff when available (advisory until configured clean).
if "$PY" -m ruff --version >/dev/null 2>&1; then
  PYTHONPATH="$ROOT/python" "$PY" -m ruff check python/fasterapi tests benchmarks scripts \
    || echo "  (ruff: findings — run '$PY -m ruff check python/')"
elif command -v ruff >/dev/null 2>&1; then
  ruff check python/fasterapi tests benchmarks scripts || true
fi
# Fast native unit tests only; full differential suite runs on pre-push.
# Skip (advisory) when optional test deps aren't installed yet.
if ! PYTHONPATH="$ROOT/python" "$PY" -c "import fastapi, starlette" 2>/dev/null; then
  echo "  (test deps missing — skipping pytest; run scripts/quickstart.sh)"
  echo "=== pre-commit OK (advisory) ==="
  exit 0
fi
# Refresh the auto-generated README tables so every commit carries fresh
# parity/bench numbers; stage the result into this commit. Fails the commit
# when parity is red (parity is king).
PYTHONPATH="$ROOT/python" "$PY" scripts/update_readme_tables.py
git add README.md
PYTHONPATH="$ROOT/python" "$PY" -m pytest tests/test_fasterapi_native.py -q
echo "=== pre-commit OK ==="
