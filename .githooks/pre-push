#!/usr/bin/env bash
# .githooks/pre-push — parity + performance gate.
#
#  1. Compiles the Rust extension (`maturin develop --release` when available).
#  2. Runs the differential parity suite; rejects the push on ANY failure.
#  3. Runs the benchmark engine (micro fast-path gate + quick macro load);
#     aborts the push on performance regressions.
#
# Bypass (not recommended): FASTERAPI_SKIP_PERF=1 git push
# Strict 3x gate:           FASTERAPI_MIN_SPEEDUP=3.0 git push
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Prefer project venv / $VIRTUAL_ENV so hooks work without extra env vars.
if [[ -n "${FASTERAPI_PY:-}" ]]; then
  PY="$FASTERAPI_PY"
elif [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
elif [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python" ]]; then
  PY="$VIRTUAL_ENV/bin/python"
else
  PY="python3"
fi
export PYTHONPATH="$ROOT/python${PYTHONPATH:+:$PYTHONPATH}"

echo "=== fasterapi pre-push gate ==="

# 1. Rust build ---------------------------------------------------------------
if command -v maturin >/dev/null 2>&1; then
  echo "[1/3] maturin develop --release"
  if "$PY" -m maturin develop --release 2>/dev/null || maturin develop --release; then
    echo "      Rust extension compiled."
  else
    echo "      WARNING: maturin build failed — continuing in pure-Python mode."
  fi
else
  echo "[1/3] maturin not found — pure-Python mode (pip install maturin for Rust fast-paths)."
fi

# 2. Parity --------------------------------------------------------------------
echo "[2/3] differential parity suite (all of tests/)"
"$PY" -m pytest tests/ -q
echo "      parity OK."

# 3. Perf -----------------------------------------------------------------------
if [[ "${FASTERAPI_SKIP_PERF:-0}" == "1" ]]; then
  echo "[3/3] perf gate skipped (FASTERAPI_SKIP_PERF=1)."
  exit 0
fi
# Micro fast-paths are stable run-to-run: strict 3x gate (router/matchit).
# Macro loopback RPS is noisy box-to-box: wide band that only catches real
# regressions. Gate writes go to a scratch file so committed bench data
# (with POST rows) is never clobbered by the hook's quick run.
echo "[3/3a] micro fast-path gate (strict x3.0)"
"$PY" benchmarks/benchmark_differential.py --micro-only --min-speedup 3.0 \
  --json-out benchmark-results/pre-push-micro.json
echo "[3/3b] macro load gate (wide band)"
MIN_MACRO="${FASTERAPI_MIN_MACRO:-0.80}"
"$PY" benchmarks/benchmark_differential.py --quick --min-speedup "$MIN_MACRO" \
  --json-out benchmark-results/pre-push-macro.json
echo "=== pre-push gate passed ==="
